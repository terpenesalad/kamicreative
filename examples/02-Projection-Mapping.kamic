      "id": "scenemv7xbcri17mfpd",
      "name": "Cube Mapping",
      "fadeIn": 0,
      "notes": "Open Stage → Projection Mapping to adjust the three cube faces.",
      "nodes": [
        {
          "id": "nmv7xbcri1ax2q1",
          "type": "util.comment",
          "x": -420,
          "y": 0,
          "values": {},
          "props": {
            "text": "This stage is split into three surfaces — the three visible faces of a cube.\n\nEach surface shows one third of the composite (its Input region) and is warped onto a face (Output warp).\n\nOpen the mapper from the stage strip (map icon), turn on Test pattern, and drag the corners onto your real object.",
            "color": "#7fd1ff"
          },
          "title": "Projection mapping"
        },
