          "type": "util.comment",
          "x": -440,
          "y": 0,
          "values": {},
          "props": {
            "text": "Control the crossfade three ways:\n\n• MIDI controller CC 1 (any channel)\n• OSC message /kami/mix with a value 0–1 (port in Preferences, default 8000)\n• The on-screen slider\n\nPress the space bar to blackout. The OSC Send module echoes the mix to 127.0.0.1:9000.",
            "color": "#c9a2ff"
          },
          "title": "MIDI & OSC"
        },
