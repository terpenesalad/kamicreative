      "id": "scenemvdscf9d1nejg4",
      "name": "Audio Reactive",
      "fadeIn": 0,
      "notes": "Uses the sound chosen with the Sound button: microphone or computer audio.",
      "nodes": [
        {
          "id": "nmvdscf9e1q9hmr",
          "type": "util.comment",
          "x": -440,
          "y": 0,
          "values": {},
          "props": {
            "text": "Values with a purple ♪ follow the sound. Right-click any number and choose Bass, Mids, Treble, Loudness or Beat to make it react; click a ♪ value to fine-tune it.\n\nHere: the ring grows with the bass, the glow follows the loudness, the colour jumps on every beat and the trails zoom with the mids.\n\nChoose what to listen to with the Sound button at the top.",
            "color": "#b58cff"
          },
          "title": "React to sound"
        },
        {
          "id": "nmvdscf9e1r9rnq",
          "type": "src.shape",
